<?xml version="1.0" encoding="utf-8"?>
<!-- Languages the app ships. Android 13+ reads this to offer a per-app language
     picker in system settings, and AppCompat needs it for setApplicationLocales
     to behave the same way on older releases.

     Indonesian is listed first and is the default: values/ holds the Indonesian
     strings, values-en/ the English ones. -->
<locale-config xmlns:android="http://schemas.android.com/apk/res/android">
    <locale android:name="id" />
    <locale android:name="en" />
</locale-config>
