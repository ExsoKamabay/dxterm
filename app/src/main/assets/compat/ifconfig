#!/bin/sh
# drac-Xterm `ifconfig` shim.
#
# Why a shim rather than the real net-tools: since Android 10 an app's uid is denied /proc/net and
# /sys/class/net. Verified on device -- the `shell` user reads /proc/net/dev, this app's uid gets
# "Permission denied" -- so a genuine ifconfig installed into the rootfs enumerates nothing at all,
# which is the empty/absent output this replaces. What an app IS permitted is ConnectivityManager;
# the app writes what that reports into the file read below, refreshed on every session start and
# on every connectivity change.
#
# Output is indented one tab so it does not sit flush against the left edge of the screen.
#
# Reads only. Bringing an interface up or down, or assigning an address, needs privileges Android
# does not grant an app, so those forms say so instead of failing silently.

set -u

SNAP=""
for c in /usr/local/share/dracxterm/net /usr/share/dracxterm/net; do
    [ -r "$c" ] && { SNAP="$c"; break; }
done

usage() {
    printf 'Usage: ifconfig [-a] [interface]\n'
    printf '\nShows the interfaces this device reports to apps.\n'
}

case "${1:-}" in
    -h|--help) usage; exit 0 ;;
esac

# Anything beyond an interface name is a configuration request.
if [ $# -gt 1 ]; then
    printf 'ifconfig: cannot change interface settings.\n' >&2
    printf 'Android does not grant an app permission to configure network interfaces, so this\n' >&2
    printf 'is refused rather than reported as done. Reading them works: run ifconfig with no\n' >&2
    printf 'arguments, or with an interface name.\n' >&2
    exit 1
fi

WANT=""
case "${1:-}" in
    -a|"") WANT="" ;;
    -*)    printf 'ifconfig: unknown option: %s\n' "$1" >&2; usage >&2; exit 1 ;;
    *)     WANT="$1" ;;
esac

if [ -z "$SNAP" ]; then
    printf 'ifconfig: no interface data available.\n' >&2
    printf 'The app writes it at session start; reopening the terminal should restore it.\n' >&2
    exit 1
fi

# Loopback is not reported by ConnectivityManager but genuinely exists in this namespace, so it is
# printed from knowledge rather than left out and making the listing look wrong.
{
    if [ -z "$WANT" ] || [ "$WANT" = "lo" ]; then
        printf '\tlo        Link encap:Local Loopback\n'
        printf '\t          inet addr:127.0.0.1  Mask:255.0.0.0\n'
        printf '\t          inet6 addr: ::1/128 Scope:Host\n'
        printf '\t          UP LOOPBACK RUNNING  MTU:65536\n\n'
    fi

    awk -v want="$WANT" -F'\t' '
        $1 == "iface" { mtu[$2]=$3; kind[$2]=$4; state[$2]=$5; if (!seen[$2]++) order[++n]=$2 }
        $1 == "addr"  { a[$2] = a[$2] sprintf("\t          %s addr: %s/%s\n", $3, $4, $5) }
        $1 == "dns"   { d[$2] = d[$2] sprintf("\t          DNS: %s\n", $3) }
        END {
            found = 0
            for (i = 1; i <= n; i++) {
                ifn = order[i]
                if (want != "" && want != ifn) continue
                found = 1
                printf "\t%-9s Link encap:%s%s\n", ifn, kind[ifn], (state[ifn]=="active" ? "  (default route)" : "")
                printf "%s", a[ifn]
                printf "%s", d[ifn]
                printf "\t          UP RUNNING  MTU:%s\n\n", (mtu[ifn] > 0 ? mtu[ifn] : "unknown")
            }
            if (want != "" && want != "lo" && !found) {
                printf "ifconfig: %s: no such interface\n", want > "/dev/stderr"
                exit 1
            }
        }
    ' "$SNAP"
}
