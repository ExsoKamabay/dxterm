#!/bin/sh
# drac-compat su shim.
# Session is fake-root (kernel euid 0). `su` / `su -` / `su root` / `sudo su` open a NON-LOGIN
# interactive root shell (bash) in SUPER_USER state (root / HOME=/root / '#') reading our themed
# rc, no banner, same session. `su -c CMD` runs CMD as root. A username argument is accepted but
# ignored (single-user container). Exiting returns to the base NORMAL shell.
cmd=""
login=0
while [ "$#" -gt 0 ]; do
  case "$1" in
    -c)                       shift; cmd="$1"; shift ;;
    -l|--login|-)             login=1; shift ;;
    -s|--shell|-m|-p|--preserve-environment) shift ;;
    --)                       shift; break ;;
    -*)                       shift ;;
    *)                        shift ;;
  esac
done
# Real sudo replaces PATH with secure_path so root-only tools in the sbin directories are found.
# Without it `sudo dpkg -i pkg.deb` dies with "'ldconfig' not found in PATH or not executable",
# because the login user's PATH carries no /usr/sbin or /sbin. Mirror Debian's default secure_path.
# /usr/local/bin stays ahead of /usr/bin so the identity shims still shadow the distro's coreutils.
PATH=/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin
export PATH
if [ -n "$cmd" ]; then
  # DRAC_SU here too, so `su -c whoami` answers root like the interactive form does.
  # The identity shims on PATH read this variable; without it the two spellings of su
  # disagree about who is running.
  export DRAC_SU=1 USER=root LOGNAME=root HOME=/root
  exec "${SHELL:-/bin/bash}" -c "$cmd"
fi
export DRAC_SU=1 USER=root LOGNAME=root HOME=/root
[ "$login" = 1 ] && cd "$HOME" 2>/dev/null
RC="${DRAC_HOME:-/home/dracos}/.bashrc"
if command -v bash >/dev/null 2>&1; then exec bash --rcfile "$RC" -i
else ENV="$RC"; export ENV; exec "${SHELL:-/bin/sh}" -i; fi
