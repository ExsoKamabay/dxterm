<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Networking: normal permission, granted at install, no runtime prompt needed. -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <!-- Legacy shared-storage (Android <= 12L). Ignored/auto-scoped on newer APIs. -->
    <uses-permission
        android:name="android.permission.READ_EXTERNAL_STORAGE"
        android:maxSdkVersion="32" />
    <uses-permission
        android:name="android.permission.WRITE_EXTERNAL_STORAGE"
        android:maxSdkVersion="29" />

    <!-- Full filesystem access (opt-in via Settings) so a Linux-style terminal can reach
         shared storage by path. Special access; the app stays fully functional if denied. -->
    <uses-permission android:name="android.permission.MANAGE_EXTERNAL_STORAGE" />

    <!-- Foreground service: keeps the app process, and therefore the shell/PTY children,
         alive while the terminal is open and the user switches to another app. specialUse is
         the honest category for an interactive terminal that must persist background shells.
         POST_NOTIFICATIONS is declared but never requested at runtime, because the app asks
         for nothing at startup. It only governs whether the mandatory service notification is
         visible; the service and the surviving shells do not depend on it. A user who wants
         the notification grants it from the system app settings. -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <application
        android:supportsRtl="false"
        android:name=".App"
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:label="@string/app_name"
        android:theme="@style/Theme.Xterm"
        android:hardwareAccelerated="true"
        android:extractNativeLibs="true"
        android:localeConfig="@xml/locales_config">

        <!-- extractNativeLibs=true is required: the proot and busybox executables have to be
             real files in nativeLibraryDir to be exec()'d from API 29. -->

        <activity
            android:name=".rootfs.ProvisioningActivity"
            android:exported="true"
            android:configChanges="orientation|screenSize|keyboardHidden|keyboard|smallestScreenSize|screenLayout|density">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <activity
            android:name=".MainActivity"
            android:exported="false"
            android:configChanges="orientation|screenSize|keyboardHidden|keyboard|smallestScreenSize|screenLayout|density"
            android:windowSoftInputMode="adjustResize" />

        <!-- Keeps terminal sessions alive in the background (see TerminalService). -->
        <service
            android:name=".TerminalService"
            android:exported="false"
            android:foregroundServiceType="specialUse">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="Keeps interactive terminal shell/PTY sessions alive while the app is in the background" />
        </service>
    </application>
</manifest>
