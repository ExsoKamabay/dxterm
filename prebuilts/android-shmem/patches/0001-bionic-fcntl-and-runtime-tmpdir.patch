-#define ASHV_KEY_SYMLINK_PATH _PATH_TMP "ashv_key_%d"
+/*
+ * Upstream builds this path from _PATH_TMP, which Termux patches into its own
+ * <paths.h> as $PREFIX/tmp. bionic's <paths.h> has no _PATH_TMP at all, so the
+ * macro does not compile outside Termux -- and when it did compile, it baked
+ * /data/data/com.termux/... into the binary, which is wrong for every other app.
+ *
+ * Resolve it at runtime from TMPDIR instead. Any Android app that runs this
+ * already has to set TMPDIR, because there is no writable /tmp on Android.
+ */
+#ifndef ASHV_TMPDIR_FALLBACK
+#define ASHV_TMPDIR_FALLBACK "/data/local/tmp"
+#endif
+
+static const char *ashv_tmpdir(void)
+{
+	const char *dir = getenv("TMPDIR");
+	/* Reject a relative or empty TMPDIR: the symlink has to be at a stable
+	 * absolute location or two processes will not find each other's keys. */
+	return (dir != NULL && dir[0] == '/') ? dir : ASHV_TMPDIR_FALLBACK;
+}
 #define ANDROID_SHMEM_SOCKNAME "/dev/shm/%08x"
