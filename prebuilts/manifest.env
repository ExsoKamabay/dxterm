# Pinned upstream sources for every prebuilt binary drac-Xterm ships.
#
# Sourced by build.sh. Nothing here is a moving target: tarballs are pinned by
# SHA-256, git checkouts by full commit SHA. Bumping a version means changing a
# line here and re-running the build, not editing a script.
#
# Why the two styles differ: GitHub's auto-generated archive tarballs are not
# guaranteed to stay byte-identical (the compression has changed before), so a
# SHA-256 over one of those is a hash that can spontaneously stop matching. A
# git commit SHA is already a content hash of the whole tree, so for GitHub
# projects we clone and check out the commit instead.

# --- Build environment -------------------------------------------------------
# Must match ndkVersion in app/build.gradle.kts, and ANDROID_API must match
# minSdk. A binary built against a newer API than the app's minSdk will fail to
# load on the oldest devices the app claims to support.
NDK_VERSION="27.0.12077973"
ANDROID_API="24"
# ABI/triple default to arm64-v8a but honour a pre-set environment. The APK
# ships both ABIs, so a full refresh is two runs:
#   ./prebuilts/build.sh --install
#   ANDROID_ABI=x86_64 TRIPLE=x86_64-linux-android ./prebuilts/build.sh --install
# Leaving them unset builds arm64.
ANDROID_ABI="${ANDROID_ABI:-arm64-v8a}"
TRIPLE="${TRIPLE:-aarch64-linux-android}"

# --- BusyBox -----------------------------------------------------------------
# The shipped libbusybox.so is built from this pin; `busybox --help` reports
# the version below. Bumping it means re-running build.sh for each ABI and
# replacing the binary under app/src/main/jniLibs/<abi>/.
BUSYBOX_VERSION="1.38.0"
BUSYBOX_URL="https://busybox.net/downloads/busybox-1.38.0.tar.bz2"
BUSYBOX_SHA256="34f9ea6ff8636f2c9241153b9114eefa9e65674a45318ae1ef95bb5f31c53bb2"

# --- talloc ------------------------------------------------------------------
# PRoot's only external dependency.
TALLOC_VERSION="2.5.0"
TALLOC_URL="https://www.samba.org/ftp/talloc/talloc-2.5.0.tar.gz"
TALLOC_SHA256="912afa237510ae542a7733998eb18a12bcda35ab6729c8e2ddb43e8d0ebab007"

# --- PRoot -------------------------------------------------------------------
# Termux's fork, not proot-me/proot upstream: it carries the Android fixes the
# app depends on. Produces both proot and its loader stub.
PROOT_REPO="https://github.com/termux/proot"
PROOT_TAG="v5.1.107.91"
PROOT_COMMIT="61681c648119"

# --- android-shmem -----------------------------------------------------------
# Termux's fork, NOT pelya/android-shmem upstream.
#
# This is load-bearing, not a preference. PRoot's sysvipc extension calls
# libandroid_shmat_fd() and libandroid_shmdt_fd(), which exist only in this
# fork; building against pelya's tree fails with "call to undeclared function
# libandroid_shmat_fd". It is also the tree the binary this replaces was built
# from, so the exported symbol set stays identical.
#
# Licence is unchanged, BSD 3-Clause, with Fredrik Fornwall's copyright added
# alongside Sergii Pylypenko's. licenses/BSD-3-Clause.txt carries both.
SHMEM_REPO="https://github.com/termux/libandroid-shmem"
SHMEM_TAG="v0.7"
SHMEM_COMMIT="7f0bd7e25dbdd146265aff7c6a890029e374622d"

# --- claw --------------------------------------------------------------------
# The in-guest `claw` command (app/src/main/assets/claw). Unlike every recipe
# above it is a GUEST binary, not an Android one: it runs inside the glibc
# rootfs, resolves DNS through the guest's /etc/resolv.conf and reads the
# guest's CA store. A static bionic build would do neither (bionic asks netd
# over a socket the guest does not have), so it is linked statically against
# musl with Zig's bundled toolchain instead of the NDK.
ZIG_VERSION="0.15.2"
ZIG_URL="https://ziglang.org/download/0.15.2/zig-x86_64-linux-0.15.2.tar.xz"
ZIG_SHA256="02aa270f183da276e5b5920b1dac44a63f1a49e55050ebde3aecc9eb82f93239"

# claw's HTTPS client. 3.5 is the current OpenSSL LTS branch.
OPENSSL_VERSION="3.5.8"
OPENSSL_URL="https://github.com/openssl/openssl/releases/download/openssl-3.5.8/openssl-3.5.8.tar.gz"
OPENSSL_SHA256="a8f84a39918ec6415ce765d9b429d313ba97b8143169c172e734b9514464f5b2"
